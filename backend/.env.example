DATABASE_URL=postgresql://guape:guape123@localhost:5432/saude_guape
SECRET_KEY=troque-esta-chave-em-producao-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=480
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=admin123
# --- Versão / auto-update ---
UPDATE_ENABLED=true
UPDATE_BRANCH=main
GITHUB_OWNER=LuckSide
GITHUB_REPO=Sistema-de-Saude-Municipal
# Repo privado: token clássico com scope `repo` (nunca commitar valor real).
# Produção: exporte GITHUB_TOKEN no servidor ou .env local (gitignored).
# GITHUB_TOKEN=ghp_...
# --- Banco principal (compose monta via POSTGRES_*; mesmos defaults) ---
# POSTGRES_USER=guape
# POSTGRES_PASSWORD=guape123
# POSTGRES_DB=saude_guape
# --- e-SUS APS / PEC (tela Integrações prevalece quando preenchida) ---
# PEC_FONTE=auto
# PEC_DATABASE_URL=postgresql://readonly_user:password@host:5432/pec_db
# --- RNDS (tela Integrações prevalece quando preenchida) ---
# RNDS_AMBIENTE=homologacao
# RNDS_CLIENT_ID=
# RNDS_SECRET=
