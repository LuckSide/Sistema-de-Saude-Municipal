# ==============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - SISTEMA DE SAÚDE MUNICIPAL
# Renomeie este arquivo para .env e preencha com credenciais fortes e seguras.
# ==============================================================================

# --- Banco de Dados PostgreSQL ---
POSTGRES_USER=guape
POSTGRES_PASSWORD=gere_uma_senha_forte_para_o_banco_aqui
POSTGRES_DB=saude_guape

# --- Segurança e Autenticação (FastAPI) ---
# Gere com: openssl rand -hex 32
SECRET_KEY=gere_uma_chave_secreta_com_minimo_32_caracteres_hexadecimais
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Superusuário Inicial ---
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=defina_uma_senha_admin_forte_aqui

# --- Pool de Conexões de Alta Concorrência (SQLAlchemy) ---
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Servidor ASGI de Produção (Gunicorn + Uvicorn) ---
GUNICORN_WORKERS=4
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=65
GUNICORN_MAX_REQUESTS=1500
GUNICORN_MAX_REQUESTS_JITTER=200

# --- Portas HTTP / HTTPS ---
PORT_HTTP=80
PORT_HTTPS=443

# --- Integração com e-SUS PEC (Opcional) ---
PEC_DATABASE_URL=
PEC_FONTE=auto
